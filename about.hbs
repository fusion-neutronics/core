<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>yamc third-party licenses</title>
    <style>
      body { font-family: sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; }
      h1 { border-bottom: 1px solid #ccc; }
      .license-text { background: #f6f8fa; padding: 1rem; overflow-x: auto; white-space: pre-wrap; }
      .used-by { font-size: 0.9rem; color: #444; }
      ul { padding-left: 1.2rem; }
    </style>
  </head>
  <body>
    <h1>Third-party licenses</h1>
    <p>
      This page lists the licenses of the third-party Rust crates bundled in
      the compiled <code>yamc</code> wheel. Every license below is a permissive
      open-source license accepted by <code>about.toml</code>; the build fails
      if a dependency introduces a license outside that allow-list.
    </p>

    <h2>Overview</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> &mdash; used by {{count}} crate(s)</li>
      {{/each}}
    </ul>

    <h2>Licenses</h2>
    {{#each licenses}}
    <h3 id="{{id}}">{{name}}</h3>
    <p class="used-by">Used by:
      {{#each used_by}}
      <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}},{{/unless}}
      {{/each}}
    </p>
    <pre class="license-text">{{text}}</pre>
    {{/each}}
  </body>
</html>
