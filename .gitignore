# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock IS committed: yamc ships wheels and executables, so a locked,
# reproducible dependency graph is required. It also keeps CI from
# re-resolving the pyo3-stub-gen git patch from scratch (which intermittently
# fails to resolve transitive deps on fresh runners).
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# python env
.yamc_env/
.venv/

__pycache__/
*.so
*.egg-info/
*.html
# The browser-demo HTML template ships inside the wheel and is consumed
# by Model.export(...). Exempt it from the broad `*.html` ignore.
!packages/yamc-core/python/yamc/_browser_template/*.html
# THIRD-PARTY-LICENSES.html is intentionally NOT committed: it's generated
# fresh by cargo-about in the wheel-build CI and shipped in the wheel, so it
# stays covered by the broad `*.html` ignore.
*.png
*.xml
*.h5
*.out

wheelhouse/
dist/
*.svg
perf*.data
*.txt
!docs/requirements.txt
!docs/assets/*.png
# Embedded nuclear-data tables consumed via include_str! (source, not artifacts)
!crates/yamc-nuclide/src/data/**/*.txt
# Auxiliary photon tabulations, read at runtime by endf::PhotonData and shipped
# in the wheel. Source data, not output. The blanket *.txt above silently drops
# them twice over: out of `git add`, which leaves the photon tests passing here
# and failing for everyone else, and out of the wheel, because maturin honours
# gitignore when it copies python-source.
!packages/yamc-core/python/yamc/data/*.txt
# Likewise the bundled material collections (regenerated by
# scripts/gen_pnnl_collection.py, but committed -- the build include_str!s them)
!crates/yamc-materials/src/collections/*.txt
*.arrow
geometry.hdf
*.vtkhdf

# Committed test fixtures and checked-in assets must stay visible in `git status`
# so that regenerating one is noticed. The broad artifact globs above otherwise
# hide these tracked files (90 `.arrow`, 14 `.h5`, the logos) -- exempt them.
# (A negation can't resurrect files inside an ignored dir like `target/`, so
# build artifacts stay ignored.)
!crates/**/tests/**/*.arrow
!crates/**/tests/**/*.h5

# ... except the nuclear-data fixtures under crates/yamc/tests, which are
# published data rather than source (issue #126). `python
# scripts/fetch_test_fixtures.py` downloads them into the same ~/.cache/yamc
# production uses and symlinks them in. Mesh fixtures (crates/yamt/tests/data)
# and the yani chain fixture are generated here, so they stay committed above.
crates/yamc/tests/*.arrow

# Local working / scratch docs -- not part of the repo
ideas.md
nwl-plan.md

# Claude Code local state
.claude/
# Jupyter notebook checkpoints and scratch notebooks
.ipynb_checkpoints/

# MkDocs build output
/site/

# NJOY writes an "output" listing into the working directory
output

# The transmute benchmark writes its timings and its golden inventories here
# (tools/bench_transmute.py). Machine-specific, and the goldens are hundreds of
# hex floats per record.
bench_transmute.json
