    @property
    def mass_number(self) -> typing.Optional[builtins.int]:
        r"""
        Mass number A = Z + N.
        
        Returns:
            Optional[int]: Mass number.
        """
    @property
    def atomic_weight_ratio(self) -> typing.Optional[builtins.float]:
        r"""
        Atomic weight ratio (target mass / neutron mass) from nuclear data file.
        
        Returns:
            Optional[float]: Atomic weight ratio.
        """
    @property
    def library(self) -> typing.Optional[builtins.str]:
